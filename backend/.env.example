# Copy to backend/.env (never commit). Kimi primary, DeepSeek fallback.
LLM_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional: RFZ GeoJSON when data/rfz/ is empty (demo VM)
# UTM_RFZ_GEOJSON=/path/to/hk_rfz_esua_snapshot.geojson
