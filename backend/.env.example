# Copy to backend/.env (never commit). Kimi primary, DeepSeek fallback.
LLM_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional: RFZ GeoJSON when data/rfz/ is empty (demo VM)
# UTM_RFZ_GEOJSON=/path/to/hk_rfz_esua_snapshot.geojson

# Optional: auto-ingest regulation PDFs at startup when the Chroma store is
# empty (used by the Docker image / Railway — see README "Production deployment")
# REGULATIONS_DIR=/path/to/regulation-pdfs
# RAG_CHROMA_DIR=/path/to/chroma   # default: <repo>/data/chroma
