# Copy to .env.local for dev. Both are optional in Phase 0.

# Backend base URL (browser-side). Defaults to http://localhost:43124.
# Set to the deployed backend URL in production (e.g. on Vercel):
#   NEXT_PUBLIC_API_URL=https://<your-service>.up.railway.app
# Set to an empty string in dev for same-origin mode — the browser calls
# /api/* on the frontend origin and next.config.ts proxies to localhost:43124:
#   NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:43124

# Cesium ion token for world imagery. Leave unset to fall back to OSM tiles.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
